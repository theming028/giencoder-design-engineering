SRC = os.path.join(REPO, 'mg-work', 'r106', 'apply106.py')
DST = os.path.join(REPO, 'mg-work', 'r107', 'apply107.py')

# 表 = (说明, 旧串, 新串, 期望命中数)。命中数不符即 sys.exit（不做任何写入）。
