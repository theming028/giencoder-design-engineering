        "    return '<style id=\"%s\">\\n%s\\n\\n%s\\n\\n%s\\n\\n%s\\n\\n%s\\n</style>\\n' % (\n"
        "        CSS_ID, CSS.strip(), BROWSE_CSS.strip(), BROWSE_DARK.strip(), R106_CSS.strip(),\n"
