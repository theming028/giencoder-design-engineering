{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "giencoder/dsl/schema.json",
  "title": "giencoder Page DSL v0",
  "description": "薄页面描述层：只描述结构 + 组件引用 + props + 数据，样式全部由 L1 tokens / L2 契约承载。AI-first：本 schema 即 LLM 生成规约。",
  "type": "object",
  "required": ["meta", "tree"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "页面标识，同时作为输出文件名" },
        "pattern": {
          "type": "string",
          "enum": ["list-page", "detail-page", "form-page", "dashboard", "config-page", "result-page"],
          "description": "页面模式（patterns.md 六大类），决定骨架默认值"
        },
        "title": { "type": "string", "description": "页面标题（title 标签 + PageHeader 默认值）" }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "description": "后台骨架（Layout Pattern）：省略则只渲染内容区",
      "properties": {
        "top-nav": {
          "type": "object",
          "required": ["logo"],
          "properties": {
            "logo": { "type": "string" },
            "subtitle": { "type": "string" },
            "links": { "type": "array", "items": { "type": "string" } },
            "user": { "type": "string", "description": "用户名，取首字渲染头像" }
          },
          "additionalProperties": false
        },
        "sidenav": {
          "type": "object",
          "properties": {
            "menu": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["group", "items"],
                "properties": {
                  "group": { "type": "string" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["text"],
                      "properties": {
                        "text": { "type": "string" },
                        "selected": { "type": "boolean", "default": false }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tree": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["c"],
      "properties": {
        "c": { "type": "string", "description": "组件 slug。必须是 component-registry.json 内的官方组件，或页面级组件（page-header / filter-bar / filter-item / top-nav / sidenav-menu）。编译期校验。" },
        "props": { "type": "object", "description": "组件 props，按该组件契约 propsIndex 校验（P0 为 emitter 必填校验）" },
        "text": { "type": "string", "description": "节点文本内容" },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "array", "items": { "$ref": "#/definitions/node" } },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "description": "具名插槽，值为子节点数组或字符串数组"
        },
        "tree": { "type": "array", "items": { "$ref": "#/definitions/node" }, "description": "默认子节点" },
        "when": { "type": "string", "description": "交互可见条件（create/edit/search…），P0 仅作标注" }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["field", "title"],
      "properties": {
        "field": { "type": "string" },
        "title": { "type": "string" },
        "width": { "type": "number" },
        "render": {
          "type": "string",
          "enum": ["text", "link", "tag", "rowActions"],
          "description": "列渲染器白名单"
        },
        "tagMap": { "type": "object", "additionalProperties": { "type": "string", "enum": ["primary", "success", "warning", "danger"] } },
        "actions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
